# Copy to .env locally. Never commit real values, embeddings, or biometric paths.
# See SECURITY.md.

# Review API (stub)
REVIEW_API_PORT=3000

# Encrypted enrollment store (opaque URI only; no local biometric dumps)
# ENROLLMENT_STORE_URI=

# Source video ingest (local paths must stay outside git)
# INGEST_STAGING_DIR=

# Enrollment artifact store (local encrypted impl). Key is base64 of 32 random bytes,
# supplied by env/secret manager only. Directory must be OUTSIDE the repo tree.
# FAMILIAR_ARTIFACT_KEY=
# FAMILIAR_ARTIFACT_DIR=
